GOOGLE_SERVICE_ACCOUNT_EMAIL=varcamp-sheets@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_RANGE="Volunteer Registrations!A:Y"
GOOGLE_SHEETS_ORGANIZER_RANGE="Organizer Registrations!A:Y"
VOLUNTEER_RATE_LIMIT_MAX=5
VOLUNTEER_RATE_LIMIT_WINDOW_SECONDS=3600
ORGANIZER_RATE_LIMIT_MAX=5
ORGANIZER_RATE_LIMIT_WINDOW_SECONDS=3600
GOOGLE_SHEETS_SPEAKER_RANGE="Speaker Registrations!A:V"
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
# Optional. Public bucket URL or custom domain; photo links in the sheet use it.
R2_PUBLIC_BASE_URL=https://photos.example.com
SPEAKER_RATE_LIMIT_MAX=5
SPEAKER_RATE_LIMIT_WINDOW_SECONDS=3600
GOOGLE_SHEETS_COMMUNITY_RANGE="Community Registrations!A:O"
COMMUNITY_RATE_LIMIT_MAX=5
COMMUNITY_RATE_LIMIT_WINDOW_SECONDS=3600
GOOGLE_SHEETS_ATTENDEE_RANGE="Attendee Registrations!A:N"
# Attendee registrations are stored here; the sheet tab above is a copy.
# Relative paths are resolved from apps/register.
ATTENDEE_DATABASE_PATH=data/attendees.sqlite
ATTENDEE_RATE_LIMIT_MAX=10
ATTENDEE_RATE_LIMIT_WINDOW_SECONDS=3600
# Attendee check-in at /2026/attendee/check-in. Share the passcode with staff;
# the session secret signs their sign-in cookie (any long random string).
CHECK_IN_PASSCODE=370782197
CHECK_IN_SESSION_SECRET=37078ea2-5805-453b-8696-f0993b892bc3
# Attendees can check themselves in without the passcode from this time.
# Defaults to 2026-11-15T08:30:00+06:30; set an earlier time to test.
# CHECK_IN_OPEN_FROM=2026-11-15T08:30:00+06:30
CHECK_IN_SIGN_IN_RATE_LIMIT_MAX=10
CHECK_IN_SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=900
